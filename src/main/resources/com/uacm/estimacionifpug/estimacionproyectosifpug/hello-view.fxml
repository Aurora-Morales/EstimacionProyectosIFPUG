<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.CheckBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uacm.estimacionifpug.estimacionproyectosifpug.HelloController"
            prefHeight="650.0" prefWidth="950.0">

    <content>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!--Titulo principal-->
            <Label text="1. Identificar la frontera de la aplicacion"
                   style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #2c3e50;"/>

            <!--Imagen-->
            <ImageView fx:id="fronteraAplicacion" fitWidth="500" preserveRatio="true">
                <image>
                    <Image url="@fronteradeaplicacion.png"/>
                </image>
            </ImageView>

            <Label text="Tiempo que va a durar el proyecto en meses:" style="-fx-font-weight: bold; -fx-font-size: 16px"/>
            <TextField fx:id="numeroDeMesesDelTrabajo" promptText="Meses"/>

            <!--Segundo tema-->
            <Label text="2. Identificar las funciones"
                   style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #2c3e50;"/>

            <Separator orientation="HORIZONTAL"/>

            <HBox spacing="20.0">
                <VBox spacing="10.0" prefWidth="400.0" HBox.hgrow="ALWAYS">
                    <Label text="Funciones de Datos ILF" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <HBox spacing="10.0">
                        <TextField fx:id="numeroFuncionesDatosILF" promptText="Cantidad" prefWidth="80.0"/>
                        <Button text="Generar" onAction="#onGenerarFuncionesDatosILFClick"
                                style="-fx-background-color: #3F7EA6; -fx-text-fill: white;"/>
                    </HBox>

                    <VBox fx:id="containerFuncionesDatosILF" spacing="10.0" style="-fx-background-color: #f4f4f4;">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                        </padding>
                    </VBox>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="10.0" prefWidth="400.0" HBox.hgrow="ALWAYS">
                    <Label text="Funciones de Datos EIF" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <HBox spacing="10.0">
                        <TextField fx:id="numeroFuncionesDatosEIF" promptText="Cantidad" prefWidth="80.0"/>
                        <Button text="Generar" onAction="#onGenerarFuncionesDatosEIFClick"
                                style="-fx-background-color: #3F7EA6; -fx-text-fill: white;"/>
                    </HBox>

                    <VBox fx:id="containerFuncionesDatosEIF" spacing="10.0" style="-fx-background-color: #f4f4f4;">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                        </padding>
                    </VBox>
                </VBox>
            </HBox>

            <Separator orientation="HORIZONTAL"/>

            <!--Tercer tema-->
            <Label text="3. Identificar las funciones de transacciones"
                   style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #2c3e50;"/>
            <HBox spacing="20.0">
                <VBox spacing="10.0" prefWidth="400.0" HBox.hgrow="ALWAYS">
                    <Label text="Entradas externas (EI)" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <HBox spacing="10.0">
                        <TextField fx:id="numeroFuncionesTransaccionesEI" promptText="Cantidad" prefWidth="80.0"/>
                        <Button text="Generar" onAction="#onGenerarFuncionesTransaccionesEI"
                                style="-fx-background-color: #3F7EA6; -fx-text-fill: white;"/>
                    </HBox>
                    <VBox fx:id="containerFuncionesTransaccionesEI" spacing="10.0" style="-fx-background-color: #f4f4f4;">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                        </padding>
                    </VBox>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="10.0" prefWidth="400.0" HBox.hgrow="ALWAYS">
                    <Label text="Salidas externas (EO)" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <HBox spacing="10.0">
                        <TextField fx:id="numeroFuncionesTransaccionesEO" promptText="Cantidad" prefWidth="80.0"/>
                        <Button text="Generar" onAction="#onGenerarFuncionesTransaccionesEO"
                                style="-fx-background-color: #3F7EA6; -fx-text-fill: white;"/>
                    </HBox>
                    <VBox fx:id="containerFuncionesTransaccionesEO" spacing="10.0" style="-fx-background-color: #f4f4f4;">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                        </padding>
                    </VBox>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <VBox spacing="10.0" prefWidth="400.0" HBox.hgrow="ALWAYS">
                    <Label text="Consultas externas (EQ)" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <HBox spacing="10.0">
                        <TextField fx:id="numeroFuncionesTransaccionesEQ" promptText="Cantidad" prefWidth="80.0"/>
                        <Button text="Generar" onAction="#onGenerarFuncionesTransaccionesEQ"
                                style="-fx-background-color: #3F7EA6; -fx-text-fill: white;"/>
                    </HBox>
                    <VBox fx:id="containerFuncionesTransaccionesEQ" spacing="10.0" style="-fx-background-color: #f4f4f4;">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                        </padding>
                    </VBox>
                </VBox>
            </HBox>
            <Separator orientation="HORIZONTAL"/>

            <Label text="4. Factor de Ajuste (VAF) - 14 Características del Sistema"
                   style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #2c3e50;"/>

            <Label text="Selecciona la opción que mejor describa las características de tu sistema:"
                   style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;"/>

            <ScrollPane prefHeight="400.0" fitToWidth="true" style="-fx-background-color: transparent;">
                <content>
                    <VBox fx:id="containerGSCs" spacing="20.0" style="-fx-padding: 10;">
                    </VBox>
                </content>
            </ScrollPane>

            <Separator orientation="HORIZONTAL"/>

            <VBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="Calcular Puntos de Función Totales"
                        onAction="#onCalcularPuntosFuncionClick"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 10 20 10 20;"/>

                <Label text="Resumen General de la Estimación:" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;"/>

                <TextArea fx:id="txtResumen" editable="false" prefHeight="280.0"
                          style="-fx-font-family: 'Courier New'; -fx-font-size: 12px;"
                          promptText="El resumen detallado incluyendo el cálculo del Factor VAF aparecerá aquí..."/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>