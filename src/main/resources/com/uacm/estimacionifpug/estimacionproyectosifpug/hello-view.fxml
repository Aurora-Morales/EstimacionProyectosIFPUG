<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uacm.estimacionifpug.estimacionproyectosifpug.HelloController"
      prefHeight="650.0" prefWidth="950.0">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="1. Identificar los elementos funcionales (ILF)"
           style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #2c3e50;"/>

    <Separator orientation="HORIZONTAL"/>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label text="Funciones de Datos" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <HBox spacing="10.0">
                <TextField fx:id="numeroElementosFuncionales" promptText="Cantidad" prefWidth="80.0"/>
                <Button text="Generar" onAction="#onGenerarFuncionesDatosClick" style="-fx-background-color: #3F7EA6; -fx-text-fill: white;"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <VBox fx:id="containerFuncionales" spacing="10.0">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label text="Funciones de Transacción" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <HBox spacing="10.0">
                <TextField fx:id="numeroElementosNoFuncionales" promptText="Cantidad" prefWidth="80.0"/>
                <Button text="Generar" onAction="#onGenerarFuncionesTransaccionesClick" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <VBox fx:id="containerNoFuncionales" spacing="10.0">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>

    </HBox>
</VBox>